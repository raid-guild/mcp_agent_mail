# syntax=docker/dockerfile:1.7
FROM python:3.14-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    PATH="/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project metadata and sync deps first for better caching
COPY pyproject.toml README.md ./
# Install runtime deps
RUN /bin/uv sync --no-dev

# Copy source
COPY src ./src

# Defaults suitable for container
ENV HTTP_HOST=0.0.0.0 \
    STORAGE_ROOT=/data/mailbox

EXPOSE 8080

# Create app user and prepare the data dir, but run as root for now so
# Railway volume permissions do not block SQLite/storage initialization.
RUN adduser --disabled-password --gecos "" --uid 10001 appuser && \
    mkdir -p /data/mailbox && chown -R appuser:appuser /data /app

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD sh -c 'curl -fsS http://127.0.0.1:${PORT:-8080}/health/liveness || exit 1'

# Run the HTTP server on Railway's injected PORT at runtime
CMD ["sh", "-c", "/bin/uv run python -m mcp_agent_mail.cli serve-http --host 0.0.0.0 --port ${PORT:-8080}"]
